#: linux/verso-service/src/commands.rs:471
#: linux/verso-linux/src/daemon.rs:518
msgid "Verso Drive is not mounted"
msgstr "Verso Drive non è montato"

#: linux/verso-service/src/commands.rs:471
#: linux/verso-linux/src/daemon.rs:518
msgid "Switch it on in Verso's Preferences, then open the link again."
msgstr "Attiva l’unità nelle Preferenze di Verso, poi apri di nuovo il link."

#: linux/verso-service/src/online.rs:544
msgid "The keyring stayed locked. Open {app}, or run “{command}”, to try again."
msgstr "Il portachiavi è rimasto bloccato. Apri {app} o esegui «{command}» per riprovare."

#: linux/verso-service/src/online.rs:545
msgid "Immich is not mounted"
msgstr "Immich non è montato"

#: linux/verso-linux/src/daemon.rs:517
msgid "Links from other apps are off"
msgstr "I link da altre app sono disattivati"

#: linux/verso-linux/src/daemon.rs:517
msgid "Turn on Immich Crosslink in Verso's settings to show what other apps link to."
msgstr "Attiva Immich Crosslink nelle impostazioni di Verso per mostrare ciò a cui rimandano altre app."

#: linux/verso-linux/src/daemon.rs:519
msgid "A link from another app cannot be opened"
msgstr "Impossibile aprire un link da un’altra app"

#: linux/verso-linux/src/daemon.rs:519
msgid "It is not a valid Immich link."
msgstr "Non è un link di Immich valido."

#: linux/verso-linux/src/daemon.rs:520
#: linux/verso-linux/src/daemon.rs:524
msgid "Nothing to show"
msgstr "Niente da mostrare"

#: linux/verso-linux/src/daemon.rs:520
msgid "Verso Drive has no place for what this link points to."
msgstr "Verso Drive non ha un posto per ciò a cui rimanda questo link."

#: linux/verso-linux/src/daemon.rs:521
msgid "Not signed in to {host}"
msgstr "Accesso non effettuato su {host}"

#: linux/verso-linux/src/daemon.rs:521
msgid "Verso is signed in to another Immich server."
msgstr "Verso ha effettuato l’accesso a un altro server Immich."

#: linux/verso-linux/src/daemon.rs:522
msgid "Another Immich account"
msgstr "Un altro account Immich"

#: linux/verso-linux/src/daemon.rs:522
msgid "The link is for another account than the one Verso is signed in with."
msgstr "Il link è per un account diverso da quello con cui Verso ha effettuato l’accesso."

#: linux/verso-linux/src/daemon.rs:525
msgid "The drive does not show this. It may be hidden, in a section that is switched off, or not shared with you."
msgstr "L’unità non mostra questo elemento. Potrebbe essere nascosto, in una sezione disattivata o non condiviso con te."

#: linux/verso-linux/src/daemon.rs:527
#: linux/verso-linux/src/daemon.rs:613
msgid "Immich is unreachable"
msgstr "Immich non è raggiungibile"

#: linux/verso-linux/src/daemon.rs:527
msgid "The Immich server cannot be reached. Try the link again later."
msgstr "Il server Immich non è raggiungibile. Riprova il link più tardi."

#: linux/verso-linux/src/daemon.rs:609
msgid "Immich's certificate is not trusted"
msgstr "Il certificato di Immich non è attendibile"

#: linux/verso-linux/src/daemon.rs:610
msgid "The Immich server presented a certificate {app} does not trust, so nothing is sent to it. Open {app} to check the certificate. Files you opened before stay available."
msgstr "Il server Immich ha presentato un certificato di cui {app} non si fida, quindi non gli viene inviato nulla. Apri {app} per controllare il certificato. I file aperti in precedenza restano disponibili."

#: linux/verso-linux/src/daemon.rs:614
msgid "The Immich server cannot be reached. Files you opened before stay available."
msgstr "Il server Immich non è raggiungibile. I file aperti in precedenza restano disponibili."

#: linux/verso-linux/src/daemon.rs:617
#: linux/verso-linux/src/tray.rs:128
msgid "Signed out of Immich"
msgstr "Disconnesso da Immich"

#: linux/verso-linux/src/daemon.rs:618
msgid "Immich no longer accepts this sign-in. Open {app} to sign in again."
msgstr "Immich non accetta più questo accesso. Apri {app} per accedere di nuovo."


#: linux/verso-service/src/commands.rs:473
#: linux/verso-linux/src/daemon.rs:522
msgid "Verso Drive is not mounted"
msgstr "Verso Drive er ikke monteret"

#: linux/verso-service/src/commands.rs:473
#: linux/verso-linux/src/daemon.rs:522
msgid "Switch it on in Verso's Preferences, then open the link again."
msgstr "Slå drevet til i Versos indstillinger, og åbn så linket igen."

#: linux/verso-service/src/online.rs:544
msgid "The keyring stayed locked. Open {app}, or run “{command}”, to try again."
msgstr "Nøgleringen forblev låst. Åbn {app}, eller kør »{command}«, for at prøve igen."

#: linux/verso-service/src/online.rs:545
msgid "Immich is not mounted"
msgstr "Immich er ikke monteret"

#: linux/verso-linux/src/daemon.rs:521
msgid "Links from other apps are off"
msgstr "Links fra andre apps er slået fra"

#: linux/verso-linux/src/daemon.rs:521
msgid "Turn on Immich Crosslink in Verso's settings to show what other apps link to."
msgstr "Slå Immich Crosslink til i Versos indstillinger for at vise, hvad andre apps linker til."

#: linux/verso-linux/src/daemon.rs:523
msgid "A link from another app cannot be opened"
msgstr "Et link fra en anden app kan ikke åbnes"

#: linux/verso-linux/src/daemon.rs:523
msgid "It is not a valid Immich link."
msgstr "Det er ikke et gyldigt Immich-link."

#: linux/verso-linux/src/daemon.rs:524
#: linux/verso-linux/src/daemon.rs:528
msgid "Nothing to show"
msgstr "Intet at vise"

#: linux/verso-linux/src/daemon.rs:524
msgid "Verso Drive has no place for what this link points to."
msgstr "Verso Drive har ikke noget sted til det, linket peger på."

#: linux/verso-linux/src/daemon.rs:525
msgid "Not signed in to {host}"
msgstr "Ikke logget ind på {host}"

#: linux/verso-linux/src/daemon.rs:525
msgid "Verso is signed in to another Immich server."
msgstr "Verso er logget ind på en anden Immich-server."

#: linux/verso-linux/src/daemon.rs:526
msgid "Another Immich account"
msgstr "En anden Immich-konto"

#: linux/verso-linux/src/daemon.rs:526
msgid "The link is for another account than the one Verso is signed in with."
msgstr "Linket er til en anden konto end den, Verso er logget ind med."

#: linux/verso-linux/src/daemon.rs:529
msgid "The drive does not show this. It may be hidden, in a section that is switched off, or not shared with you."
msgstr "Drevet viser ikke dette. Det kan være skjult, i en sektion, der er slået fra, eller ikke delt med dig."

#: linux/verso-linux/src/daemon.rs:531
#: linux/verso-linux/src/daemon.rs:617
msgid "Immich is unreachable"
msgstr "Immich kan ikke nås"

#: linux/verso-linux/src/daemon.rs:531
msgid "The Immich server cannot be reached. Try the link again later."
msgstr "Immich-serveren kan ikke nås. Prøv linket igen senere."

#: linux/verso-linux/src/daemon.rs:613
msgid "Immich's certificate is not trusted"
msgstr "Immichs certifikat er ikke betroet"

#: linux/verso-linux/src/daemon.rs:614
msgid "The Immich server presented a certificate {app} does not trust, so nothing is sent to it. Open {app} to check the certificate. Files you opened before stay available."
msgstr "Immich-serveren viste et certifikat, som {app} ikke stoler på, så der sendes intet til den. Åbn {app} for at tjekke certifikatet. Filer, du har åbnet før, er stadig tilgængelige."

#: linux/verso-linux/src/daemon.rs:618
msgid "The Immich server cannot be reached. Files you opened before stay available."
msgstr "Immich-serveren kan ikke nås. Filer, du har åbnet før, er stadig tilgængelige."

#: linux/verso-linux/src/daemon.rs:621
#: linux/verso-linux/src/tray.rs:135
msgid "Signed out of Immich"
msgstr "Logget ud af Immich"

#: linux/verso-linux/src/daemon.rs:622
msgid "Immich no longer accepts this sign-in. Open {app} to sign in again."
msgstr "Immich accepterer ikke længere dette login. Åbn {app} for at logge ind igen."


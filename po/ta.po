msgstr "{server} உடன் இணைக்கப்பட்டுள்ளது"

#: linux/verso-linux/src/tray.rs:127
msgid "{server} is not reachable"
msgstr "{server} ஐ அணுக முடியவில்லை"

#: linux/verso-linux/src/tray.rs:129
msgid "Signed in to {server}"
msgstr "{server} இல் உள்நுழைந்துள்ளீர்கள்"

#: linux/verso-linux/src/tray.rs:138
msgid "Verso Drive is unmounted"
msgstr "Verso Drive அன்மவுண்ட் செய்யப்பட்டுள்ளது"

#: linux/verso-linux/src/tray.rs:141
msgid "Server version: Immich {version}"
msgstr "சேவையகப் பதிப்பு: Immich {version}"

#: linux/verso-linux/src/tray.rs:144
msgid "Signed in as: {account}"
msgstr "உள்நுழைந்துள்ள கணக்கு: {account}"

#: linux/verso-linux/src/tray.rs:148
msgid "Try Again Now"
msgstr "இப்போதே மீண்டும் முயல்"

#: linux/verso-linux/src/tray.rs:152
msgid "Open {app}"
msgstr "{app}-ஐத் திற"

#: linux/verso-linux/src/tray.rs:155
msgid "Open in Files"
msgstr "கோப்புகள் பயன்பாட்டில் திற"

#: linux/verso-linux/src/tray.rs:161
msgid "Unmount Verso Drive"
msgstr "Verso Drive-ஐ அன்மவுண்ட் செய்"

#: linux/verso-linux/src/tray.rs:163
msgid "Mount Verso Drive"
msgstr "Verso Drive-ஐ மவுண்ட் செய்"

#: linux/verso-linux/src/tray.rs:166
msgid "Preferences…"
msgstr "விருப்பங்கள்…"

#: linux/verso-linux/src/tray.rs:169
msgid "Get {app} {version}…"
msgstr "{app} {version}-ஐப் பதிவிறக்கு…"

#: linux/verso-linux/src/tray.rs:175
msgid "Sign In…"
msgstr "உள்நுழைக…"

#: linux/verso-linux/src/tray.rs:177
msgid "Sign Out…"
msgstr "வெளியேறு…"

#: linux/verso-linux/src/tray.rs:179
msgid "Quit {app}"
msgstr "{app}-ஐ மூடு"

#: linux/verso-linux/src/updates.rs:53
msgid "{app} {version} is available"
msgstr "{app} {version} கிடைக்கிறது"

#: linux/verso-linux/src/updates.rs:54
msgid "Get it from jakob.hviid.phd/verso."
msgstr "jakob.hviid.phd/verso இலிருந்து பதிவிறக்கவும்."

#: linux/verso-desktop/src/preferences.rs:180
msgid "Custom ({size})"
msgstr "தனிப்பயன் ({size})"

#: linux/verso-desktop/src/preferences.rs:193
msgid "Apps that take part are found by themselves. Turn one off to leave it out of Show in. One not found stays listed for 30 days, so it stays off if it comes back; Forget removes it now."
msgstr "பங்கேற்கும் பயன்பாடுகள் தானாகவே கண்டறியப்படும். ஒரு பயன்பாட்டை \"…-இல் காட்டு\" என்பதிலிருந்து விலக்க அதை அணைக்கவும். கண்டறியப்படாத பயன்பாடு 30 நாட்கள் பட்டியலில் இருக்கும், எனவே திரும்ப வந்தாலும் அணைந்தே இருக்கும்; \"மறந்துவிடு\" அதை இப்போதே நீக்கும்."

#: linux/verso-desktop/src/preferences.rs:198
msgid "Apps That Take Part"
msgstr "பங்கேற்கும் பயன்பாடுகள்"

#: linux/verso-desktop/src/preferences.rs:208
msgid "Open photos, albums, people and places in Immich's web app in your browser, or copy their address."
msgstr "புகைப்படங்கள், ஆல்பங்கள், நபர்கள், இடங்களை உலாவியில் Immich வலைப் பயன்பாட்டில் திறக்கவும், அல்லது அவற்றின் முகவரியை நகலெடுக்கவும்."

#: linux/verso-desktop/src/preferences.rs:209
msgid "Show photos, albums, people and places in other apps that take part, and show what they send in Verso."
msgstr "புகைப்படங்கள், ஆல்பங்கள், நபர்கள், இடங்களைப் பங்கேற்கும் பிற பயன்பாடுகளில் காட்டவும், அவை அனுப்புவதை Verso-இல் காட்டவும்."

#: linux/verso-desktop/src/preferences.rs:211
msgid "Other apps can show photos, albums, people and places in the gallery."
msgstr "பிற பயன்பாடுகள் புகைப்படங்கள், ஆல்பங்கள், நபர்கள், இடங்களைக் கேலரியில் காட்டலாம்."

#: linux/verso-desktop/src/preferences.rs:212
msgid "Other apps can show them in Files, while the drive is on."
msgstr "டிரைவ் இயக்கத்தில் இருக்கும்போது, பிற பயன்பாடுகள் அவற்றைக் கோப்புகள் பயன்பாட்டில் காட்டலாம்."

#: linux/verso-desktop/src/preferences.rs:248
msgid "Double-Click Opens"
msgstr "இருமுறை கிளிக் செய்தால் திறப்பது"

#: linux/verso-desktop/src/preferences.rs:249
#: linux/verso/src/drive_preferences.rs:185
#: linux/verso/src/drive_preferences.rs:214
msgid "Colour"
msgstr "வண்ணம்"

#: linux/verso-desktop/src/preferences.rs:251
#: linux/verso-desktop/src/preferences.rs:50
#: linux/verso-desktop/src/preferences.rs:50
#: linux/verso-desktop/src/preferences.rs:50
msgid "Light Style"
msgstr "வெளிர் பாணி"

#: linux/verso-desktop/src/preferences.rs:252
#: linux/verso-desktop/src/preferences.rs:50
#: linux/verso-desktop/src/preferences.rs:50
msgid "Dark Style"
msgstr "அடர் பாணி"

#: linux/verso-desktop/src/preferences.rs:67
#: linux/verso-desktop/src/preferences.rs:67
#: linux/verso-desktop/src/preferences.rs:67
msgid "Location"
msgstr "இருப்பிடம்"

#: linux/verso-desktop/src/preferences.rs:68
#: linux/verso-desktop/src/preferences.rs:68
#: linux/verso-desktop/src/preferences.rs:68
msgid "Name in the Sidebar"

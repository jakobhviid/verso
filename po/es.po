msgstr "{error}. El archivo se conserva en {folder}."

#: linux/verso-linux/src/fuse.rs:706
msgid "This computer lets a file operation take at most {seconds} seconds (fs.fuse.default_request_timeout). Set it to 0 for longer uploads. The file is kept in {folder}."
msgstr "Este equipo permite que una operación de archivo dure como máximo {seconds} segundos (fs.fuse.default_request_timeout). Ponlo a 0 para subidas más largas. El archivo se conserva en {folder}."

#: linux/verso-linux/src/fuse.rs:716
msgid "The upload took too long. The file is kept in {folder}."
msgstr "La subida tardó demasiado. El archivo se conserva en {folder}."

#: linux/verso-linux/src/fuse.rs:1190
msgid "Immich takes photos and videos only."
msgstr "Immich solo admite fotos y vídeos."


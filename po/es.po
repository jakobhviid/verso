#: linux/verso-service/src/commands.rs:473
#: linux/verso-linux/src/daemon.rs:524
msgid "Verso Drive is not mounted"
msgstr "Verso Drive no está montado"

#: linux/verso-service/src/commands.rs:473
#: linux/verso-linux/src/daemon.rs:524
msgid "Switch it on in Verso's Preferences, then open the link again."
msgstr "Activa la unidad en las Preferencias de Verso y vuelve a abrir el enlace."

#: linux/verso-service/src/online.rs:544
msgid "The keyring stayed locked. Open {app}, or run “{command}”, to try again."
msgstr "El depósito de claves siguió bloqueado. Abre {app} o ejecuta «{command}» para volver a intentarlo."

#: linux/verso-service/src/online.rs:545
msgid "Immich is not mounted"
msgstr "Immich no está montado"

#: linux/verso-linux/src/daemon.rs:523
msgid "Links from other apps are off"
msgstr "Los enlaces de otras apps están desactivados"

#: linux/verso-linux/src/daemon.rs:523
msgid "Turn on Immich Crosslink in Verso's settings to show what other apps link to."
msgstr "Activa Immich Crosslink en los ajustes de Verso para mostrar lo que enlazan otras apps."

#: linux/verso-linux/src/daemon.rs:525
msgid "A link from another app cannot be opened"
msgstr "No se puede abrir un enlace de otra app"

#: linux/verso-linux/src/daemon.rs:525
msgid "It is not a valid Immich link."
msgstr "No es un enlace de Immich válido."

#: linux/verso-linux/src/daemon.rs:526
#: linux/verso-linux/src/daemon.rs:530
msgid "Nothing to show"
msgstr "No hay nada que mostrar"

#: linux/verso-linux/src/daemon.rs:526
msgid "Verso Drive has no place for what this link points to."
msgstr "Verso Drive no tiene dónde mostrar aquello a lo que apunta este enlace."

#: linux/verso-linux/src/daemon.rs:527
msgid "Not signed in to {host}"
msgstr "No has iniciado sesión en {host}"

#: linux/verso-linux/src/daemon.rs:527
msgid "Verso is signed in to another Immich server."
msgstr "Verso tiene la sesión iniciada en otro servidor de Immich."

#: linux/verso-linux/src/daemon.rs:528
msgid "Another Immich account"
msgstr "Otra cuenta de Immich"

#: linux/verso-linux/src/daemon.rs:528
msgid "The link is for another account than the one Verso is signed in with."
msgstr "El enlace es de una cuenta distinta de aquella con la que Verso ha iniciado sesión."

#: linux/verso-linux/src/daemon.rs:531
msgid "The drive does not show this. It may be hidden, in a section that is switched off, or not shared with you."
msgstr "La unidad no muestra esto. Puede estar oculto, en una sección desactivada o no compartido contigo."

#: linux/verso-linux/src/daemon.rs:533
#: linux/verso-linux/src/daemon.rs:619
msgid "Immich is unreachable"
msgstr "No se puede acceder a Immich"

#: linux/verso-linux/src/daemon.rs:533
msgid "The Immich server cannot be reached. Try the link again later."
msgstr "No se puede acceder al servidor de Immich. Vuelve a probar el enlace más tarde."

#: linux/verso-linux/src/daemon.rs:615
msgid "Immich's certificate is not trusted"
msgstr "El certificado de Immich no es de confianza"

#: linux/verso-linux/src/daemon.rs:616
msgid "The Immich server presented a certificate {app} does not trust, so nothing is sent to it. Open {app} to check the certificate. Files you opened before stay available."
msgstr "El servidor de Immich presentó un certificado en el que {app} no confía, así que no se le envía nada. Abre {app} para revisar el certificado. Los archivos que abriste antes siguen disponibles."

#: linux/verso-linux/src/daemon.rs:620
msgid "The Immich server cannot be reached. Files you opened before stay available."
msgstr "No se puede acceder al servidor de Immich. Los archivos que abriste antes siguen disponibles."

#: linux/verso-linux/src/daemon.rs:623
#: linux/verso-linux/src/tray.rs:140
msgid "Signed out of Immich"
msgstr "Sesión de Immich cerrada"

#: linux/verso-linux/src/daemon.rs:624
msgid "Immich no longer accepts this sign-in. Open {app} to sign in again."
msgstr "Immich ya no acepta este inicio de sesión. Abre {app} para volver a iniciar sesión."


#: linux/verso-service/src/commands.rs:467
#: linux/verso-linux/src/daemon.rs:498
msgid "Verso Drive is not mounted"
msgstr "Verso Drive माउंट केलेले नाही"

#: linux/verso-service/src/commands.rs:467
#: linux/verso-linux/src/daemon.rs:498
msgid "Switch it on in Verso's Preferences, then open the link again."
msgstr "Verso च्या प्राधान्यांमध्ये ड्राइव्ह चालू करा, नंतर दुवा पुन्हा उघडा."

#: linux/verso-service/src/online.rs:448
msgid "The keyring stayed locked. Open {app}, or run “{command}”, to try again."
msgstr "कीरिंग लॉक राहिली. पुन्हा प्रयत्न करण्यासाठी {app} उघडा, किंवा “{command}” चालवा."

#: linux/verso-service/src/online.rs:449
msgid "Immich is not mounted"
msgstr "Immich माउंट केलेले नाही"

#: linux/verso-linux/src/daemon.rs:497
msgid "Links from other apps are off"
msgstr "इतर ॲप्सकडील दुवे बंद आहेत"

#: linux/verso-linux/src/daemon.rs:497
msgid "Turn on Immich Crosslink in Verso's settings to show what other apps link to."
msgstr "इतर ॲप्स ज्याकडे दुवा देतात ते दाखवण्यासाठी Verso च्या सेटिंग्जमध्ये Immich Crosslink सुरू करा."

#: linux/verso-linux/src/daemon.rs:499
msgid "A link from another app cannot be opened"
msgstr "दुसऱ्या ॲपकडील दुवा उघडता येत नाही"

#: linux/verso-linux/src/daemon.rs:499
msgid "It is not a valid Immich link."
msgstr "हा वैध Immich दुवा नाही."

#: linux/verso-linux/src/daemon.rs:500
#: linux/verso-linux/src/daemon.rs:504
msgid "Nothing to show"
msgstr "दाखवण्यासारखे काही नाही"

#: linux/verso-linux/src/daemon.rs:500
msgid "Verso Drive has no place for what this link points to."
msgstr "हा दुवा ज्याकडे निर्देश करतो, त्यासाठी Verso Drive मध्ये जागा नाही."

#: linux/verso-linux/src/daemon.rs:501
msgid "Not signed in to {host}"
msgstr "{host} वर साइन इन केलेले नाही"

#: linux/verso-linux/src/daemon.rs:501
msgid "Verso is signed in to another Immich server."
msgstr "Verso दुसऱ्या Immich सर्व्हरवर साइन इन केलेले आहे."

#: linux/verso-linux/src/daemon.rs:502
msgid "Another Immich account"
msgstr "दुसरे Immich खाते"

#: linux/verso-linux/src/daemon.rs:502
msgid "The link is for another account than the one Verso is signed in with."
msgstr "हा दुवा दुसऱ्या खात्यासाठी आहे, Verso ज्या खात्याने साइन इन केलेले आहे त्यासाठी नाही."

#: linux/verso-linux/src/daemon.rs:505
msgid "The drive does not show this. It may be hidden, in a section that is switched off, or not shared with you."
msgstr "ड्राइव्ह हे दाखवत नाही. ते लपवलेले असू शकते, बंद केलेल्या विभागात असू शकते, किंवा तुमच्याशी शेअर केलेले नसू शकते."

#: linux/verso-linux/src/daemon.rs:507
#: linux/verso-linux/src/daemon.rs:583
msgid "Immich is unreachable"
msgstr "Immich पर्यंत पोहोचता येत नाही"

#: linux/verso-linux/src/daemon.rs:507
msgid "The Immich server cannot be reached. Try the link again later."
msgstr "Immich सर्व्हरपर्यंत पोहोचता येत नाही. नंतर दुवा पुन्हा उघडून पहा."

#: linux/verso-linux/src/daemon.rs:584
msgid "The Immich server cannot be reached. Files you opened before stay available."
msgstr "Immich सर्व्हरपर्यंत पोहोचता येत नाही. आधी उघडलेल्या फाइल उपलब्ध राहतील."

#: linux/verso-linux/src/daemon.rs:587
#: linux/verso-linux/src/tray.rs:128
msgid "Signed out of Immich"
msgstr "Immich मधून साइन आउट झाले"

#: linux/verso-linux/src/daemon.rs:588
msgid "Immich no longer accepts this sign-in. Open {app} to sign in again."
msgstr "Immich आता हे साइन-इन स्वीकारत नाही. पुन्हा साइन इन करण्यासाठी {app} उघडा."

#: linux/verso-linux/src/folders.rs:204
msgid "Uploaded to Immich: {folder}"
msgstr "Immich वर अपलोड झाले: {folder}"

#: linux/verso-linux/src/folders.rs:206
msgid "Photos and videos in the timeline: {count}"
msgstr "टाइमलाइनमधील फोटो आणि व्हिडिओ: {count}"

#: linux/verso-linux/src/folders.rs:207
msgid "Albums it can make: {albums}"
msgstr "यातून बनू शकणारे अल्बम: {albums}"

#: linux/verso-linux/src/folders.rs:210
msgid "Files not uploaded: {count}"
msgstr "अपलोड न झालेल्या फाइल्स: {count}"

#: linux/verso-linux/src/folders.rs:213
#: shared/verso-core/src/settings.rs:174
msgid "Make Albums"
msgstr "अल्बम बनवा"

#: linux/verso-linux/src/folders.rs:213
#: shared/verso-core/src/settings.rs:173
msgid "Timeline Only"
msgstr "फक्त टाइमलाइन"

#: linux/verso-linux/src/folders.rs:234
msgid "Albums made from {folder}"
msgstr "{folder} मधून अल्बम बनवले"

#: linux/verso-linux/src/folders.rs:236
msgid "No albums made from {folder}"
msgstr "{folder} मधून एकही अल्बम बनला नाही"

#: linux/verso-linux/src/folders.rs:242
msgid "Immich does not let this account make albums ({permission}). The photos and videos are in the timeline."
msgstr "Immich या खात्याला अल्बम बनवू देत नाही ({permission}). फोटो आणि व्हिडिओ टाइमलाइनमध्ये आहेत."

#: linux/verso-linux/src/folders.rs:247
msgid "Signed out of Immich. The photos and videos are in the timeline."
msgstr "Immich मधून साइन आउट झाले. फोटो आणि व्हिडिओ टाइमलाइनमध्ये आहेत."

#: linux/verso-linux/src/fuse.rs:647
#: linux/verso-linux/src/fuse.rs:695
#: linux/verso-linux/src/fuse.rs:701
#: linux/verso-linux/src/fuse.rs:711
#: linux/verso-linux/src/fuse.rs:1185
msgid "Not uploaded: {name}"
msgstr "अपलोड झाले नाही: {name}"

#: linux/verso-linux/src/fuse.rs:647
msgid "The file is incomplete, as if its copy was cancelled."
msgstr "फाइल अपूर्ण आहे, जणू तिची कॉपी रद्द केली गेली."

#: linux/verso-linux/src/fuse.rs:663
msgid "Uploading {name} to Immich"
msgstr "{name} Immich वर अपलोड होत आहे"

#: linux/verso-linux/src/fuse.rs:664
msgid "The copy finishes once Immich has the file."
msgstr "Immich ला फाइल मिळताच कॉपी पूर्ण होईल."

#: linux/verso-linux/src/fuse.rs:677
msgid "Restored from the trash: {name}"
msgstr "कचरापेटीतून परत आणले: {name}"

#: linux/verso-linux/src/fuse.rs:678
msgid "Immich had this photo in its trash, and copying it in brought it back."
msgstr "हा फोटो Immich च्या कचरापेटीत होता, आणि तो कॉपी केल्याने परत आला."

#: linux/verso-linux/src/fuse.rs:682
msgid "Immich has this photo already, so nothing was added."
msgstr "हा फोटो Immich मध्ये आधीच आहे, त्यामुळे काहीही जोडले नाही."

#: linux/verso-linux/src/fuse.rs:683
msgid "Already in Immich: {name}"
msgstr "Immich मध्ये आधीच आहे: {name}"

#: linux/verso-linux/src/fuse.rs:692
msgid "{error}. The file is kept in {folder}."
msgstr "{error}. फाइल {folder} मध्ये ठेवली आहे."

#: linux/verso-linux/src/fuse.rs:702
msgid "This computer lets a file operation take at most {seconds} seconds (fs.fuse.default_request_timeout). Set it to 0 for longer uploads. The file is kept in {folder}."
msgstr "हा संगणक फाइल ऑपरेशनला जास्तीत जास्त {seconds} सेकंद देतो (fs.fuse.default_request_timeout). जास्त वेळ लागणाऱ्या अपलोडसाठी ते 0 वर सेट करा. फाइल {folder} मध्ये ठेवली आहे."

#: linux/verso-linux/src/fuse.rs:712
msgid "The upload took too long. The file is kept in {folder}."
msgstr "अपलोडला खूप वेळ लागला. फाइल {folder} मध्ये ठेवली आहे."

#: linux/verso-linux/src/fuse.rs:1185
msgid "Immich takes photos and videos only."
msgstr "Immich फक्त फोटो आणि व्हिडिओ घेते."

#: linux/verso-linux/src/notify.rs:68
msgid "The Immich server is not reachable, so it cannot be downloaded now. What you opened before still opens."
msgstr "Immich सर्व्हरपर्यंत पोहोचता येत नाही, त्यामुळे फाइल आत्ता डाउनलोड करता येत नाही. तुम्ही आधी उघडलेले अजूनही उघडते."

#: linux/verso-linux/src/notify.rs:73
msgid "{drive} cannot open “{name}”"
msgstr "{drive} “{name}” उघडू शकत नाही"


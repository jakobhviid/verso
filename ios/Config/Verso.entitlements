<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The App Group the app and its extensions share, `group.` and the bundle identifier on iOS (project build
	     settings). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(VERSO_APP_GROUP)</string>
	</array>
	<!-- Verso Drive's credential, which its extension reads (mac/Shared/Account.swift). -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(VERSO_IDENTITY)</string>
	</array>
</dict>
</plist>

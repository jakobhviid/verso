<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app's App Group and Keychain group (Verso.entitlements): the drive's account, settings and store, which
	     the app keeps for the extension (mac/Shared/Account.swift). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(VERSO_APP_GROUP)</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(VERSO_IDENTITY)</string>
	</array>
</dict>
</plist>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- An Immich server on the local network is often reached over plain http, as on the iPhone. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Verso connects to your Immich server, which may be on your local network.</string>
	<!-- The App Group it writes the Top Shelf into (TVShelfData), and its scheme, which the shelf's items open. -->
	<key>VersoAppGroup</key>
	<string>$(VERSO_APP_GROUP)</string>
	<key>VersoURLScheme</key>
	<string>$(IMMICH_URL_SCHEME)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(VERSO_IDENTITY)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(IMMICH_URL_SCHEME)</string>
			</array>
		</dict>
	</array>
	<!-- Standard encryption alone (HTTPS, and Apple's own for the iPhone's connection), as the iPhone's app declares, so
	     a build needs no answer in App Store Connect before TestFlight's external testers get it. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSHumanReadableCopyright</key>
	<string>Verso is an independent, unofficial project. It is not affiliated with, endorsed by, or sponsored by the Immich project or FUTO.</string>
	<!-- Set Up with iPhone: the iPhones nearby with Verso's Set Up Apple TV open (DeviceDiscoveryUI). -->
	<key>NSApplicationServices</key>
	<dict>
		<key>Browses</key>
		<array>
			<dict>
				<key>NSApplicationServiceIdentifier</key>
				<string>verso-tv-setup</string>
				<key>NSApplicationServicePlatformSupport</key>
				<array>
					<string>iOS</string>
				</array>
				<key>NSApplicationServiceUsageDescription</key>
				<string>Verso signs in with the iPhone you choose.</string>
			</dict>
		</array>
	</dict>
</dict>
</plist>
